# StructBench environment template.
#
#   cp .env.example .env    # then fill in whichever providers you have keys for
#
# StructBench reads keys from the environment. `structbench` does NOT load .env
# automatically; export the variables in your shell, or use a dotenv loader of
# your choice (`set -a && . ./.env && set +a`).
#
# Nothing here is required for the offline demo:
#   structbench run --models mock:good,mock:flaky

# ---- DeepSeek (OpenAI compatible) -------------------------------------------
STRUCTBENCH_DEEPSEEK_API_KEY=
# STRUCTBENCH_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Alibaba DashScope / Qwen (OpenAI compatible mode) ----------------------
STRUCTBENCH_DASHSCOPE_API_KEY=
# STRUCTBENCH_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Zhipu GLM (OpenAI compatible) -----------------------------------------
STRUCTBENCH_ZHIPU_API_KEY=
# STRUCTBENCH_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- Moonshot / Kimi -------------------------------------------------------
STRUCTBENCH_MOONSHOT_API_KEY=
# STRUCTBENCH_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ---- SiliconFlow -----------------------------------------------------------
STRUCTBENCH_SILICONFLOW_API_KEY=
# STRUCTBENCH_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- OpenAI ----------------------------------------------------------------
STRUCTBENCH_OPENAI_API_KEY=
# STRUCTBENCH_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Local Ollama (no key needed) ------------------------------------------
# STRUCTBENCH_OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Custom OpenAI-compatible endpoint -------------------------------------
# STRUCTBENCH_CUSTOM_API_KEY=
# STRUCTBENCH_CUSTOM_BASE_URL=http://localhost:8000/v1

# ---- Runtime knobs ---------------------------------------------------------
STRUCTBENCH_CONCURRENCY=5
STRUCTBENCH_TIMEOUT=120
STRUCTBENCH_MAX_RETRIES=1
